# Copy to .env.local (gitignored). See AGENTS.md "Dev against live" and #3.
GATEWAI_MANAGEMENT_URL=https://gateway.example/v0/management
GATEWAI_MANAGEMENT_KEY=
GATEWAI_HOST_LABEL=local
# Optional: JSON map of sha256(client key) -> label for the ledger.
# GATEWAI_CLIENTS_FILE=./clients.json
# Optional: alert rules, read-only. See alerts.example.json.
# GATEWAI_ALERTS_FILE=./alerts.json
# Optional: email on every alert crossing through Cloudflare Email Sending.
# CLOUDFLARE_ACCOUNT_ID=
# CLOUDFLARE_EMAIL_SENDING_API_TOKEN=          # or CLOUDFLARE_EMAIL_SENDING_API_TOKEN_FILE=/run/secrets/...
# GATEWAI_ALERT_EMAIL_FROM=alerts@example.com
# GATEWAI_ALERT_EMAIL_TO=ops@example.com
