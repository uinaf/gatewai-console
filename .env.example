# Copy to .env.local (gitignored), or let `pnpm run env` write it from 1Password.
# Each variable is read in the file named beside it.

# src/server/management/api.ts
GATEWAI_MANAGEMENT_URL=https://<your-gateway>/v0/management   # default http://127.0.0.1:8317/v0/management
GATEWAI_MANAGEMENT_KEY=                                        # or GATEWAI_MANAGEMENT_KEY_FILE=/run/secrets/management-key
# GATEWAI_MANAGEMENT_TIMEOUT=10 seconds

# src/server/database.ts
# GATEWAI_DB_PATH=data/console.sqlite                          # the container sets /data/console.sqlite

# src/functions/pools.ts
GATEWAI_HOST_LABEL=local

# src/server/ledger/collector.ts and clients.ts
# GATEWAI_COLLECT=true
# GATEWAI_CLIENTS_FILE=./clients.json                          # JSON map of sha256(client key) -> label, read-only

# src/server/alerts/rules.ts
# GATEWAI_ALERTS_FILE=./alerts.json                            # see alerts.example.json, read-only

# src/server/alerts/email.ts: email on every alert crossing through Cloudflare Email Sending
# CLOUDFLARE_ACCOUNT_ID=
# CLOUDFLARE_EMAIL_SENDING_API_TOKEN=                          # or CLOUDFLARE_EMAIL_SENDING_API_TOKEN_FILE=/run/secrets/...
# GATEWAI_ALERT_EMAIL_FROM=alerts@example.com
# GATEWAI_ALERT_EMAIL_TO=ops@example.com

# nitro
# PORT=3000
# HOST=0.0.0.0
